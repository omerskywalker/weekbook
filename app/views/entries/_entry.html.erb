<div id="<%= dom_id(entry) %>" class="group rounded-xl border border-cream-200 bg-white px-5 py-4 shadow-warm transition-all duration-150 hover:border-cream-300">
  <p class="text-sm leading-relaxed text-ink-800"><%= entry.content %></p>
  <div class="mt-3 flex items-center justify-between">
    <time class="text-xs text-ink-400"><%= entry.created_at.strftime('%a %-d %b · %-I:%M %p') %></time>
    <%= button_to entry_path(entry),
        method: :delete,
        data: { turbo_confirm: "Remove this entry?" },
        class: "cursor-pointer text-xs text-ink-300 opacity-0 transition-opacity group-hover:opacity-100 hover:text-red-400" do %>
      Remove
    <% end %>
  </div>
</div>
