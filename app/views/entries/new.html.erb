<div class="flex min-h-[80vh] items-start justify-center px-4 pt-8 sm:pt-16" data-controller="char-count">

  <div class="w-full max-w-xl">
    <div class="mb-6">
      <p class="text-xs font-medium uppercase tracking-widest text-amber">Week <%= Date.current.cweek %></p>
      <h1 class="font-display text-3xl font-light text-ink-900">Write an entry</h1>
      <p class="mt-1 text-sm text-ink-500"><%= Date.current.strftime('%A, %B %-d') %></p>
    </div>

    <%= render 'prompt', prompt: @prompt %>

    <%= form_with model: @entry, url: entries_path do |f| %>
      <%= f.text_area :content,
          autofocus: true,
          rows: 10,
          placeholder: "What's on your mind? What happened today?",
          data: { char_count_target: "input", action: "input->char-count#update keydown->char-count#submitOnCmd" },
          class: "w-full resize-none rounded-xl border border-cream-300 bg-white px-5 py-4 text-base leading-relaxed text-ink-800 placeholder-ink-300 shadow-warm transition-colors focus:border-amber focus:outline-none focus:ring-1 focus:ring-amber" %>

      <div class="mt-3 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <p class="text-xs text-ink-400" data-char-count-target="counter">0 / 500</p>
          <p class="text-xs text-ink-300">
            <kbd class="rounded border border-cream-300 bg-cream-100 px-1 py-0.5 font-mono text-xs">⌘ Enter</kbd> to save
          </p>
        </div>
        <div class="flex items-center gap-3">
          <%= link_to "Cancel", entries_path, class: "text-sm text-ink-400 hover:text-ink-600 transition-colors" %>
          <%= f.submit "Save entry",
              data: { char_count_target: "submit" },
              class: "cursor-pointer rounded-lg bg-amber px-5 py-2.5 text-sm font-medium text-ink-900 transition-all duration-150 hover:bg-amber-light hover:-translate-y-px active:translate-y-0 disabled:cursor-not-allowed disabled:opacity-40" %>
        </div>
      </div>
    <% end %>
  </div>

</div>
