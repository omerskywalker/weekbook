<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Weekbook</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-cream-200 text-ink-800 font-sans">

    <nav class="sticky top-0 z-50 border-b border-white/5 bg-ink-900" data-controller="mobile-menu">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3.5">

        <%= link_to root_path, class: "group flex items-center gap-2" do %>
          <span class="h-2 w-2 rounded-full bg-amber transition-all duration-300 group-hover:scale-125"></span>
          <span class="font-display text-xl font-light tracking-tight text-white">Weekbook</span>
        <% end %>

        <%# Desktop nav — hidden below md %>
        <div class="hidden items-center gap-5 text-sm md:flex">
          <% if user_signed_in? %>
            <%= link_to "Write", new_entry_path,
                class: "rounded-md bg-amber/10 px-3 py-1.5 text-amber transition-colors duration-200 hover:bg-amber/20" %>
            <%= link_to "Feed", feed_path,
                class: "text-ink-300 transition-colors duration-200 hover:text-white" %>
            <%= link_to "Digests", weekly_digests_path,
                class: "text-ink-300 transition-colors duration-200 hover:text-white" %>
            <% if current_user.username.present? %>
              <%= link_to "Profile", user_profile_path(current_user.username),
                  class: "text-ink-300 transition-colors duration-200 hover:text-white" %>
            <% else %>
              <%= link_to "Complete profile", edit_profile_path,
                  class: "text-ink-300 transition-colors duration-200 hover:text-white" %>
            <% end %>
            <%= link_to "Sign out", destroy_user_session_path,
                data: { turbo_method: :delete },
                class: "text-ink-500 transition-colors duration-200 hover:text-ink-300" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path,
                class: "text-ink-300 transition-colors duration-200 hover:text-white" %>
            <%= link_to "Get started", new_user_registration_path,
                class: "rounded-md bg-amber px-3.5 py-1.5 font-medium text-ink-900 transition-all duration-200 hover:bg-amber-light hover:-translate-y-px active:translate-y-0" %>
          <% end %>
        </div>

        <%# Mobile hamburger — visible below md %>
        <button class="flex items-center justify-center rounded-md p-1.5 text-ink-300 transition-colors hover:text-white md:hidden"
                data-action="click->mobile-menu#toggle"
                aria-label="Toggle menu">
          <svg data-mobile-menu-target="openIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg data-mobile-menu-target="closeIcon" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <%# Mobile dropdown — toggled by Stimulus %>
      <div data-mobile-menu-target="menu" class="hidden border-t border-white/5 md:hidden">
        <div class="space-y-1 px-4 py-3">
          <% if user_signed_in? %>
            <%= link_to "Write", new_entry_path,
                data: { action: "click->mobile-menu#close" },
                class: "block rounded-md bg-amber/10 px-3 py-2.5 text-sm font-medium text-amber" %>
            <%= link_to "Feed", feed_path,
                data: { action: "click->mobile-menu#close" },
                class: "block rounded-md px-3 py-2.5 text-sm text-ink-300 transition-colors hover:bg-white/5 hover:text-white" %>
            <%= link_to "Digests", weekly_digests_path,
                data: { action: "click->mobile-menu#close" },
                class: "block rounded-md px-3 py-2.5 text-sm text-ink-300 transition-colors hover:bg-white/5 hover:text-white" %>
            <% if current_user.username.present? %>
              <%= link_to "Profile", user_profile_path(current_user.username),
                  data: { action: "click->mobile-menu#close" },
                  class: "block rounded-md px-3 py-2.5 text-sm text-ink-300 transition-colors hover:bg-white/5 hover:text-white" %>
            <% else %>
              <%= link_to "Complete profile", edit_profile_path,
                  data: { action: "click->mobile-menu#close" },
                  class: "block rounded-md px-3 py-2.5 text-sm text-ink-300 transition-colors hover:bg-white/5 hover:text-white" %>
            <% end %>
            <div class="mt-2 border-t border-white/5 pt-2">
              <%= link_to "Sign out", destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "block rounded-md px-3 py-2.5 text-sm text-ink-500 transition-colors hover:bg-white/5 hover:text-ink-300" %>
            </div>
          <% else %>
            <%= link_to "Sign in", new_user_session_path,
                data: { action: "click->mobile-menu#close" },
                class: "block rounded-md px-3 py-2.5 text-sm text-ink-300 transition-colors hover:bg-white/5 hover:text-white" %>
            <%= link_to "Get started", new_user_registration_path,
                data: { action: "click->mobile-menu#close" },
                class: "block rounded-md bg-amber px-3 py-2.5 text-sm font-medium text-ink-900" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="border-b border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm text-emerald-800" data-turbo-temporary>
        <div class="mx-auto max-w-5xl"><%= notice %></div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="border-b border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-700" data-turbo-temporary>
        <div class="mx-auto max-w-5xl"><%= alert %></div>
      </div>
    <% end %>

    <main class="mx-auto max-w-5xl px-4 py-6 sm:py-10">
      <%= yield %>
    </main>

  </body>
</html>
