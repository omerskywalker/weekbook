<div class="mx-auto max-w-2xl animate-slide-up">
  <div class="mb-6">
    <p class="text-sm font-medium text-amber">Week <%= Date.current.cweek %> · <%= Date.current.cwyear %></p>
    <h1 class="font-display text-3xl font-light text-ink-900">New digest</h1>
    <p class="mt-1 text-sm text-ink-500"><%= Date.current.beginning_of_week(:monday).strftime('%b %-d') %> – <%= Date.current.end_of_week(:monday).strftime('%b %-d, %Y') %></p>
  </div>

  <div class="rounded-xl border border-cream-300 bg-white p-6 shadow-warm">
    <%= render 'form', digest: @digest %>
  </div>
</div>
