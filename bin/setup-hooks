#!/usr/bin/env bash
# Run once after cloning: bin/setup-hooks
# Points git at the tracked hooks in .githooks/

set -e

git config core.hooksPath .githooks
chmod +x .githooks/pre-push

echo "✓ Git hooks configured — pre-push checks are now active."
echo "  Bypass any time with: SKIP_HOOKS=1 git push"
